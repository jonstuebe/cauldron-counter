{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cauldron-counter",
  "compatibility_date": "2026-11-15",
  // Wrangler runs the build before every deploy/preview, so Workers Builds works
  // with no build command set in the dashboard. The build downloads Godot and the
  // Web export template when they are not installed (scripts/godot.mjs).
  "build": { "command": "npm run build" },
  // Only handles *.wasm: it serves the brotli-compressed engine, because the raw
  // index.wasm (~40 MB) is over the 25 MiB per-asset limit.
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*.wasm"]
  },
  // Production hostname (Previews keep their own *.workers.dev URLs).
  "routes": [
    { "pattern": "cauldron-counter.jonstuebe.com", "custom_domain": true }
  ],
  // Enables Workers Previews (`wrangler preview`). Nothing differs from production, so it's empty.
  "previews": {}
}
