{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cauldron-counter",
  "compatibility_date": "2026-11-15",
  // Wrangler runs the Vite build before every deploy/preview, so Workers Builds
  // works even with no build command set in the dashboard.
  "build": { "command": "npm run build" },
  // Static site: Vite builds into dist/, Workers serves it as assets (no Worker script needed).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Production hostname (Previews keep their own *.workers.dev URLs).
  "routes": [
    { "pattern": "cauldron-counter.jonstuebe.com", "custom_domain": true }
  ],
  // Enables Workers Previews (`wrangler preview`). Nothing differs from production, so it's empty.
  "previews": {}
}
